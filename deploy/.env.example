# Configuration du serveur de production : copier en « .env » à côté de docker-compose.yml.
#   cp .env.example .env && nano .env && chmod 600 .env
# Ne jamais publier le fichier .env (il contient tous les secrets) : il est ignoré par Git.

# ── Options docker compose actives ──
# https : Caddy + certificat HTTPS automatique (indispensable : visio, Stripe, Google)
# turn : relais coturn pour la visio entre réseaux différents (voir la section TURN plus bas)
# Ajouter « ,monitoring » pour Prometheus/Grafana (≈ 500 Mo de mémoire en plus)
COMPOSE_PROFILES=https,turn

# ── Images (compte GitHub qui publie sur ghcr.io) ──
GHCR_OWNER=riahichaima
# Versions déployées (latest au premier démarrage). Retour arrière : mettre le tag (12 caractères du SHA)
# d'une ancienne version puis « docker compose up -d ».
BACKEND_TAG=latest
AI_TAG=latest
FRONTEND_TAG=latest

# ── Adresses publiques ──
# Nom DNS de la VM (Azure : IP publique → Configuration → étiquette DNS)
API_DOMAIN=lms-api-chaima.swedencentral.cloudapp.azure.com
# Adresse du frontend Vercel (liens des emails, retours Stripe, seule origine autorisée par CORS)
PUBLIC_APP_URL=https://lms-chaima.vercel.app
# Adresse de l'API vue par les navigateurs (variable API_URL du projet Vercel)
PUBLIC_API_URL=https://lms-api-chaima.swedencentral.cloudapp.azure.com

# ── Base de données : mots de passe longs et aléatoires (openssl rand -base64 32) ──
DB_USERNAME=lms
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── Sécurité (obligatoire) ──
# Clé de signature des jetons : openssl rand -base64 64
JWT_SECRET=
# Unique super administrateur, créé au premier démarrage (mot de passe fort, jamais partagé)
SUPER_ADMIN_EMAIL=superadmin@lms.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Administrateur

# ── Service IA : Azure AI Foundry ──
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_TRANSCRIBE_DEPLOYMENT=gpt-4o-mini-transcribe
# Images analysées par vidéo (coût Azure) ; 0 = transcription audio seulement
VIDEO_FRAME_COUNT=4

# ── Limites d'appels à l'IA par utilisateur et par heure (protègent le crédit Azure ; 0 = illimité) ──
AI_CHAT_PER_HOUR=30
AI_GENERATION_PER_HOUR=10
AI_CORRECTION_PER_HOUR=30

# ── Fichiers des cours : taille maximale d'un envoi (au-delà, lien YouTube conseillé) ──
MAX_UPLOAD_SIZE=200MB

# ── Emails (SMTP) ──
# Test : sandbox Mailtrap (les emails restent dans la boîte Mailtrap)
# Production ouverte au public : fournisseur SMTP réel (ex. Brevo smtp-relay.brevo.com:587, ou Gmail
# smtp.gmail.com:587 avec un mot de passe d'application) pour que chacun reçoive ses emails.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Stripe (MODE TEST uniquement : clés sk_test_… et whsec_…) ──
# Webhook : https://<API_DOMAIN>/api/payments/webhook (événement checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Réunions en visio (WebRTC) ──
APP_TIMEZONE=Africa/Tunis
# Relais TURN (profil « turn », coturn sur ce serveur) : visio entre réseaux qui bloquent la connexion
# directe (4G, écoles). Ouvrir dans le pare-feu (NSG + ufw) : 3478 UDP/TCP et 49160-49200 UDP.
TURN_URL=turn:lms-api-chaima.swedencentral.cloudapp.azure.com:3478?transport=udp,turn:lms-api-chaima.swedencentral.cloudapp.azure.com:3478?transport=tcp
TURN_USERNAME=lms
# Mot de passe du relais : openssl rand -hex 24
TURN_CREDENTIAL=
# IP publique / IP privée de la VM (Azure est derrière une traduction d'adresse), ex. 20.240.167.200/10.0.0.4
TURN_EXTERNAL_IP=

# ── Connexion avec Google (facultatif) ──
# Google Cloud Console → Identifiants → ID client OAuth « Application Web »
# Origine JavaScript autorisée : PUBLIC_APP_URL. Vide = bouton masqué.
GOOGLE_CLIENT_ID=

# ── Sauvegardes (scripts backup.sh / restore.sh) ──
BACKUP_DIR=/opt/lms/backups
BACKUP_KEEP_DAYS=7

# ── Option supervision (COMPOSE_PROFILES=https,monitoring) ──
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=127.0.0.1:3000
