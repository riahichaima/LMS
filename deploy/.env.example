# Configuration du serveur de production : copier en « .env » à côté de docker-compose.yml.
# Ne jamais publier le fichier .env (il contient tous les secrets).

# ── Images (compte GitHub qui publie sur ghcr.io) ──
GHCR_OWNER=riahichaima
# Versions déployées : mises à jour automatiquement par les workflows CD (latest au premier démarrage)
BACKEND_TAG=latest
FRONTEND_TAG=latest
AI_TAG=latest

# ── Adresses publiques ──
# Sans nom de domaine : http://<IP-du-serveur> et http://<IP-du-serveur>:8090
# Avec HTTPS (profil https) : https://app.mon-lms.com et https://api.mon-lms.com
PUBLIC_APP_URL=http://localhost
PUBLIC_API_URL=http://localhost:8090
FRONTEND_PORT=80
BACKEND_PORT=8090

# ── Option HTTPS (docker compose --profile https up -d) ──
# Avec Caddy, publier frontend/backend seulement en local :
#   FRONTEND_PORT=127.0.0.1:8081  et  BACKEND_PORT=127.0.0.1:18090
APP_DOMAIN=
API_DOMAIN=
ACME_EMAIL=

# ── Base de données (mots de passe longs et aléatoires) ──
DB_USERNAME=lms
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── Sécurité (obligatoire) — générer avec : openssl rand -base64 64 ──
JWT_SECRET=
SUPER_ADMIN_EMAIL=superadmin@lms.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Administrateur

# ── Service IA : Azure AI Foundry ──
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_TRANSCRIBE_DEPLOYMENT=gpt-4o-mini-transcribe

# ── Emails ──
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Stripe (mode TEST) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Réunions en visio (WebRTC — HTTPS obligatoire en production) ──
APP_TIMEZONE=Africa/Tunis
# Serveur TURN facultatif (ex. turn:turn.mon-lms.com:3478) pour les réseaux restrictifs
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Option supervision (docker compose --profile monitoring up -d) ──
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=127.0.0.1:3000
