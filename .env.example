# Modèle de configuration du backend : copier en « .env » (ignoré par Git) et remplir.
# En production, définir ces mêmes noms comme variables d'environnement.

# ── Base de données MariaDB / MySQL ──
DB_URL=jdbc:mysql://localhost:3306/lms_db?allowPublicKeyRetrieval=true&useSSL=false&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=

# ── Sécurité (obligatoires) ──
# Clé de signature des jetons : longue chaîne aléatoire (ex. : openssl rand -base64 64)
JWT_SECRET=

# Durée de validité des jetons (ms) : 24 h
JWT_EXPIRATION=86400000
SUPER_ADMIN_EMAIL=superadmin@lms.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Administrateur

# ── URLs ──
# Adresse du frontend (liens des emails, retours Stripe)
FRONTEND_URL=http://localhost:4200
# Origines autorisées à appeler l'API, séparées par des virgules (ex. : https://lms.vercel.app)
APP_CORS_ORIGINS=
# Service IA (LMS_AI)
LMS_AI_URL=http://localhost:8000

# ── Emails (Mailtrap en développement) ──
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Stripe (mode TEST uniquement ; vide = paiement en ligne désactivé) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Divers ──
JPA_SHOW_SQL=false
UPLOAD_DIR=uploads/videos
