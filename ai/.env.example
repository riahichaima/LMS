# Copier ce fichier en .env puis remplir la clé

# ── Azure AI Foundry ──
# Foundry > projet > Models + endpoints > votre déploiement > Endpoint "Target URI" (partie https://....openai.azure.com) et Key
AZURE_OPENAI_ENDPOINT=https://<ressource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_TRANSCRIBE_DEPLOYMENT=gpt-4o-mini-transcribe
VIDEO_FRAME_COUNT=8

# Dossier de travail (fichiers temporaires)
UPLOAD_DIR=uploads
